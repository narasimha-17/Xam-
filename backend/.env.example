DATABASE_URL=postgresql+asyncpg://lms:lms@localhost:5432/lms
SYNC_DATABASE_URL=postgresql+psycopg2://lms:lms@localhost:5432/lms
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads/pdfs
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=Admin
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=

JUDGE0_URL=
JUDGE0_API_KEY=

# Leave blank to fall back to logging the password-reset OTP to the backend
# console instead of emailing it. For Gmail: SMTP_HOST=smtp.gmail.com,
# SMTP_PORT=587, SMTP_USERNAME=your Gmail address, SMTP_PASSWORD=a 16-char
# Google "App Password" (myaccount.google.com/apppasswords) — NOT your normal
# Gmail password, and requires 2-Step Verification enabled on the account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Local-only Ollama model — leave AI_FEATURES_ENABLED=false in any environment
# that doesn't have `ollama serve` running with this model pulled.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
AI_FEATURES_ENABLED=true

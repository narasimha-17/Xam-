DATABASE_URL=postgresql+asyncpg://lms:lms@localhost:5432/lms
SYNC_DATABASE_URL=postgresql+psycopg2://lms:lms@localhost:5432/lms

# Firebase Admin SDK service account, as a single-line raw JSON string. Generate
# one at Firebase Console > Project settings > Service accounts > Generate new
# private key, then paste the whole file's contents here (minified to one line).
# Required — every authenticated request verifies its token through this.
FIREBASE_SERVICE_ACCOUNT_JSON=

UPLOAD_DIR=uploads/pdfs
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# The account that becomes admin the first time it signs in via Firebase.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Admin
JDOODLE_CLIENT_ID=
JDOODLE_CLIENT_SECRET=

JUDGE0_URL=
JUDGE0_API_KEY=

# Optional — only used if you still want transactional email for something else.
# Not required for login/password-reset anymore (Firebase handles both).
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=

# Local-only Ollama model — leave AI_FEATURES_ENABLED=false in any environment
# that doesn't have `ollama serve` running with this model pulled.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
AI_FEATURES_ENABLED=true
